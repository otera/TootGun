{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TootGun",
  "version": "1.0.0",
  "identifier": "com.tootgun.client",
  "build": {
    "beforeDevCommand": "npx vite --config vite.tauri.config.mts",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx vite build --config vite.tauri.config.mts",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
